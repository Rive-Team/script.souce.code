	local function callback(stateData, iteratorData)
		for key, iteratorData in pairs(iteratorData) do
			if stateData[key] ~= nil then
				if typeof(iteratorData) ~= "table" then
					if key ~= "Color" or typeof(stateData[key]) ~= "table" then
						local item = stateData[key]
						stateData[key] = isCallbackValid(key, item)
						if typeof(iteratorData) ~= "boolean" then
							item = iteratorData
							if typeof(stateData[key]) ~= typeof(item) then
								stateData[key] = iteratorData
							end
						else
							stateData[key] = stateData[key] == true
						end
					end
				elseif typeof(stateData[key]) == "table" then
					callback(stateData[key], iteratorData)
				else
					stateData[key] = handler(iteratorData)
				end
			else
				stateData[key] = handler(iteratorData)
			end
		end

		for key in pairs(stateData) do
			if iteratorData[key] == nil and key ~= "Color" then
				stateData[key] = nil
			end
		end
	end

