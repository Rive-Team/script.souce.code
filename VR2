	textButtonVariantC.MouseButton1Click:Connect(function()
		ChangeToggleColor(textButtonVariantC)

		if textButtonVariantC.Ticket_Asset.ImageColor3 == Color3.fromRGB(0, 255, 0) then
			local parts = {}
			for _, part in ipairs(GetRoot(LocalPlayer).Parent:GetChildren()) do
				if part:IsA("BasePart") and part.CanCollide == true then
					table.insert(parts, part)
				end
			end

			while textButtonVariantC.Ticket_Asset.ImageColor3 == Color3.fromRGB(0, 255, 0) do
				wait(0.1)
				pcall(function()
					for _, part in ipairs(parts) do
						if LocalPlayer.Character[part.Name].CanCollide then
							task.wait()
							LocalPlayer.Character[part.Name].CanCollide = false
						end
					end
				end)
			end

			for _, part in ipairs(parts) do
				if not LocalPlayer.Character[part.Name].CanCollide then
					task.wait(0.01)
					LocalPlayer.Character[part.Name].CanCollide = true
				end
			end
		end

		game.Players.LocalPlayer.Character.Humanoid:ChangeState("GettingUp")
	end)

