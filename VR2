	function BrookBring(argument, flag)
		local secondaryPlayer = game.Players[argument]
		local Platform = game.workspace:FindFirstChild("Platform")

		if not Platform then
			Platform = Instance.new("Part")
			Platform.Name = "Platform"
			Platform.Anchored = true
			Platform.Size = Vector3.new(200, 1, 200)
			Platform.CFrame = CFrame.new(0, -500, 0)
