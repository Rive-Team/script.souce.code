	function GetNearPlayers(secondaryPlayer, secondaryArgument)
		local players = game:GetService("Players")
		local position = {}
		local humanoidRootPartContainer = secondaryPlayer.Character

		if not humanoidRootPartContainer then
			return position
		end

		local HumanoidRootPart = humanoidRootPartContainer:FindFirstChild("HumanoidRootPart")
		if not HumanoidRootPart then
			return position
		end

		for _, item in ipairs(players:GetPlayers()) do
			if item ~= secondaryPlayer then
				local secondaryCharacter = item.Character
				if secondaryCharacter then
					local humanoidRootPartNumber = secondaryCharacter:FindFirstChild("HumanoidRootPart")
					if humanoidRootPartNumber then
						local magnitude = (HumanoidRootPart.Position - humanoidRootPartNumber.Position).Magnitude
						if magnitude <= secondaryArgument then
							table.insert(position, { Player = item, Distance = magnitude })
						end
					end
				end
			end
		end

		table.sort(position, function(a, b)
			return a.Distance < b.Distance
		end)

		local states = {}
		for _, item in ipairs(position) do
			table.insert(states, item.Player)
		end
		return states
	end

	local function concat(matchState)
		local gmatchData = {}
		local concatCondition = matchState:match("[\216-\219][\128-\191]")

		for concatText in matchState:gmatch("[%z\001-\127\194-\244][\128-\191]*") do
			if concatText == " " then
				table.insert(gmatchData, "  ")
			else
				table.insert(gmatchData, "«" .. concatText .. "»")
			end
		end

		if concatCondition then
			local concatData = {}
			for index = #gmatchData, 1, -1 do
				table.insert(concatData, gmatchData[index])
			end
			return table.concat(concatData, "")
		end

		return table.concat(gmatchData, "")
	end

