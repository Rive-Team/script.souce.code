			Platform.Transparency = 1
			Platform.Parent = workspace
		end

		local sum = 0
		local number = 0
		local HumanoidRootPartCFrame = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame

		repeat
			task.wait()
			number = number + 1

			local getSofa = GetSofa()
			if not getSofa then
				SendNotify("System VR2", "تحتاج كلبشه حتا تقدر تسحب", 5)
				break
			end

			local instance = nil

			if getSofa.Seat1.Occupant ~= nil then
				if not getSofa.Seat1.Occupant or getSofa.Seat1.Occupant ~= secondaryPlayer.Character.Humanoid then
					if getSofa.Seat1.Occupant and getSofa.Seat1.Occupant ~= secondaryPlayer.Character.Humanoid then
						if getSofa.Seat2.Occupant ~= nil then
							if getSofa.Seat2.Occupant and getSofa.Seat2.Occupant == secondaryPlayer.Character.Humanoid then
								instance = getSofa.Seat2
							end
						else
							instance = getSofa.Seat2
						end
					end
				else
					instance = getSofa.Seat1
				end
			else
				instance = getSofa.Seat1
			end

			if secondaryPlayer.Character.Humanoid.Sit and instance == secondaryPlayer.Character.Humanoid.SeatPart then
				if not flag then
					local HumanoidRootPart = game.Players.LocalPlayer.Character.HumanoidRootPart
					HumanoidRootPart.CFrame = Platform.CFrame * CFrame.new(0, 5, 0)
				else
					game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = HumanoidRootPartCFrame
					game.Players.LocalPlayer.Character.Humanoid:ChangeState("GettingUp")
				end

				wait(1)
				getSofa.Parent = game.Players.LocalPlayer.Backpack
				break
			end

			if secondaryPlayer.Character.Humanoid.Sit and instance ~= secondaryPlayer.Character.Humanoid.SeatPart then
				SendNotify("System VR2", "لايمكن سحب الضحية لانه قاعد", 5)
				break
			end

			if getSofa.Parent ~= game.Players.LocalPlayer.Character then
				getSofa.Parent = game.Players.LocalPlayer.Character
			end

			local product = math.sin(sum) * 4
			sum = sum + 0.2
			local position = secondaryPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, -4.5 + product, 0) + secondaryPlayer.Character.HumanoidRootPart.CFrame.lookVector * -0.7 + secondaryPlayer.Character.HumanoidRootPart.Velocity * Vector3.new(0.2, 0, 0.2)
			local lookVector = secondaryPlayer.Character.HumanoidRootPart.CFrame.lookVector * Vector3.new(1, 0, 1)
			instance.CFrame = CFrame.new(position, position - lookVector)
		until number >= 200

		game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = HumanoidRootPartCFrame
		game.Players.LocalPlayer.Character.Humanoid:ChangeState("GettingUp")
	end

