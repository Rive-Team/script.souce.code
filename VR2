		tool.ToolTip = "اختار شخص"

		function handler()
			local MouseTarget = Mouse.Target
			local player = nil

			if MouseTarget and MouseTarget.Parent then
				if MouseTarget.Parent:IsA("Model") then
					player = game.Players:GetPlayerFromCharacter(MouseTarget.Parent)
				elseif MouseTarget.Parent:IsA("Accessory") then
					player = game.Players:GetPlayerFromCharacter(MouseTarget.Parent.Parent)
				end

				if player and player ~= game.Players.LocalPlayer then
					UpdateTarget(player)
				end
			end
		end

		tool.Activated:Connect(handler)
