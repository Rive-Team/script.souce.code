	getgenv().ChangeColor.MouseButton1Click:Connect(function()
		local colorsResult = Colors()
		local secondaryR = colorsResult.r
		local secondaryG = colorsResult.g
		local secondaryB = colorsResult.b
		local currentState = colorsResult.r2
		local nextState = colorsResult.g2
		local result = colorsResult.b2

		b = secondaryB
		secondaryCapturedG = secondaryG
		capturedR = secondaryR
		capturedResult = result
		capturedState = nextState
		secondaryCapturedState = currentState
		getgenv().ColorforFback = Color3.fromRGB(secondaryR, secondaryG, secondaryB)

		local secondaryColor = Color3.fromRGB(secondaryR, secondaryG, secondaryB)
		local alternateColor = Color3.fromRGB(currentState, nextState, result)

		local function handleResult(resultText)
			for _, item in ipairs(getgenv().colorSections) do
				if resultText == Color3.fromRGB(item.r, item.g, item.b) then
					return "primary"
				end
				if resultText == Color3.fromRGB(item.r2, item.g2, item.b2) then
					return "secondary"
				end
			end
		end

		for _, item in ipairs(getgenv().VR2:GetDescendants()) do
			local function handler(property, color)
				pcall(function()
					item[property] = color
				end)
			end

			local success, textColor = pcall(function()
				return item.TextColor3
			end)

			if success and textColor then
				local resultType = handleResult(textColor)
				if resultType == "primary" then
					handler("TextColor3", secondaryColor)
				elseif resultType == "secondary" then
					handler("TextColor3", alternateColor)
				end
			end

			if (item:IsA("ImageLabel") or item:IsA("ImageButton")) and item.Name ~= "Profile_Image" and item.Name ~= "TargetImage" and item.Name ~= "Logger_Button" and item.Name ~= "ClickTargetTool_Button" and item.Name ~= "Developer" and item.Name ~= "Ticket_Asset" then
				local success, imageColor = pcall(function()
					return item.ImageColor3
				end)

				if success and imageColor then
					local resultType = handleResult(imageColor)
					if resultType == "primary" then
						handler("ImageColor3", secondaryColor)
					elseif resultType == "secondary" then
						handler("ImageColor3", alternateColor)
					end
				end
			end

			local success, bgColor = pcall(function()
				return item.BackgroundColor3
			end)

			if success and bgColor then
				local resultType = handleResult(bgColor)
				if resultType == "primary" then
					handler("BackgroundColor3", secondaryColor)
				elseif resultType == "secondary" then
					handler("BackgroundColor3", alternateColor)
				end
			end

			local success, borderColor = pcall(function()
				return item.BorderColor3
			end)

			if success and borderColor then
				local resultType = handleResult(borderColor)
				if resultType == "primary" then
					handler("BorderColor3", secondaryColor)
				elseif resultType == "secondary" then
					handler("BorderColor3", alternateColor)
				end
			end

			if item:IsA("UIStroke") then
				local resultType = handleResult(item.Color)
				if resultType == "primary" then
					pcall(function()
						item.Color = secondaryColor
					end)
				elseif resultType == "secondary" then
					pcall(function()
						item.Color = alternateColor
					end)
				end
			end
		end

		getgenv().Discord_Button.ImageColor3 = Color3.fromRGB(255, 255, 255)
		getgenv().RightsLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
