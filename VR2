	function GetPlayer(argument)
		if argument == "" then
			return nil
		end

		argument = argument:match("^%s*(.-)%s*$")
		for _, item in ipairs(game.Players:GetPlayers()) do
			if item ~= game.Players.LocalPlayer then
				local name = item.Name:lower():match("^%s*(.-)%s*$")
				local displayName = item.DisplayName:lower():match("^%s*(.-)%s*$")
				if name:sub(1, #argument) == argument:lower() or displayName:sub(1, #argument) == argument:lower() then
					return item
				end
			end
		end
		return nil
	end

